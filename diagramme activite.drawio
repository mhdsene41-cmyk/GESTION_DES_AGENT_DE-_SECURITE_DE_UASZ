        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagramme d&#39;activités\ntitle Traitement d&#39;une demande de sécurité\n\nskinparam dpi 180\nskinparam shadowing true\nskinparam ArrowThickness 2\nskinparam ActivityBorderThickness 2\nskinparam BackgroundColor white\n\nskinparam activity {\n    BackgroundColor #EAF4FC\n    BorderColor #1F4E79\n    FontSize 17\n    FontStyle bold\n    DiamondBackgroundColor #FFF9C4\n    DiamondBorderColor #1F4E79\n    StartColor #7ED957\n    EndColor #FF6B6B\n}\n\nstart\n\n:Se connecter;\n\nif (Authentification réussie ?) then (Oui)\n\n:Créer une demande;\n\n:Remplir le formulaire;\n\n:Envoyer la demande;\n\n:Enregistrer dans la base de données;\n\n:Notifier le chef de sécurité;\n\n:Consulter la demande;\n\nif (Décision ?) then (Accepter)\n\n:Mettre le statut à \&quot;Acceptée\&quot;;\n\nelse (Refuser)\n\n:Mettre le statut à \&quot;Refusée\&quot;;\n\nendif\n\n:Notifier l&#39;enseignant;\n\n:L&#39;enseignant consulte le statut;\n\nstop\n\nelse (Non)\n\n:Afficher un message d&#39;erreur;\n\nstop\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IBcioYTuJSYr0CWDJT-g-102">
