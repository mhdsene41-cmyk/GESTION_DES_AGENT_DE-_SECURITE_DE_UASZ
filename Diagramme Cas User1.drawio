        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\ntitle Diagramme de cas d&#39;utilisation\ntitle Plateforme de gestion des agents de sécurité de l&#39;UASZ\n\nskinparam shadowing true\nskinparam packageStyle rectangle\nskinparam usecase {\n    BackgroundColor #E8F4FD\n    BorderColor #1F4E79\n}\nskinparam actor {\n    BackgroundColor #FFF2CC\n    BorderColor #7F6000\n}\n\nactor Administrateur\nactor \&quot;Chef de sécurité\&quot; as Chef\nactor Agent\nactor Enseignant\nactor \&quot;Responsable Domaine\&quot; as RD\n\nrectangle \&quot;Plateforme de gestion des agents de sécurité\&quot; {\n\nusecase \&quot;Se connecter\&quot; as UC0\n\nusecase \&quot;Gérer les comptes\\nutilisateurs\&quot; as UC1\nusecase \&quot;Gérer les agents\&quot; as UC2\nusecase \&quot;Consulter les rapports\&quot; as UC3\nusecase \&quot;Administrer la plateforme\&quot; as UC4\n\nusecase \&quot;Affecter les agents\&quot; as UC5\nusecase \&quot;Vérifier les présences\&quot; as UC6\nusecase \&quot;Consulter les incidents\&quot; as UC7\nusecase \&quot;Traiter les demandes\&quot; as UC8\n\nusecase \&quot;Consulter son planning\&quot; as UC9\nusecase \&quot;Enregistrer sa présence\&quot; as UC10\nusecase \&quot;Signaler un incident\&quot; as UC11\n\nusecase \&quot;Soumettre une demande\&quot; as UC12\nusecase \&quot;Suivre une demande\&quot; as UC13\n\nusecase \&quot;Consulter les statistiques\&quot; as UC14\n\n}\n\nAdministrateur --&gt; UC0\nChef --&gt; UC0\nAgent --&gt; UC0\nEnseignant --&gt; UC0\nRD --&gt; UC0\n\nAdministrateur --&gt; UC1\nAdministrateur --&gt; UC2\nAdministrateur --&gt; UC3\nAdministrateur --&gt; UC4\n\nChef --&gt; UC5\nChef --&gt; UC6\nChef --&gt; UC7\nChef --&gt; UC8\n\nAgent --&gt; UC9\nAgent --&gt; UC10\nAgent --&gt; UC11\n\nEnseignant --&gt; UC12\nEnseignant --&gt; UC13\n\nRD --&gt; UC14\nRD --&gt; UC3\n\nUC11 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &